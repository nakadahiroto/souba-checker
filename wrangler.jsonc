{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    // /go/<id> の転送先。ASPで発行されたURLをここに貼って `npx wrangler deploy`（ページの再生成は不要）
    "LINKS": "{\"main\":\"\",\"homes\":\"\",\"ieul\":\"\",\"home4u\":\"\",\"sumai-value\":\"\"}"
  }
}
